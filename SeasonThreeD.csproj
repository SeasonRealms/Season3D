<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <AssemblyName>SeasonThreeD</AssemblyName>
    <RootNamespace>Season.ThreeD</RootNamespace>
    <PackageId>SeasonThreeD</PackageId>
    <Title>SeasonThreeD</Title>
    <Authors>SeasonRealms</Authors>
    <Company>SeasonRealms</Company>
    <Description>SeasonThreeD wraps the trellis.cpp image-to-3D worker (TRELLIS.2 / Pixal3D, GGML) for SeasonEngine: run one image through the trellis-cli pipeline and get a textured GLB back, with stage/step progress and cancellation.</Description>
    <PackageTags>trellis;trellis.cpp;ggml;3d;image-to-3d;mesh;glb;ai;seasonengine</PackageTags>
    <PackageProjectUrl>https://github.com/SeasonRealms/SeasonThreeD</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeasonRealms/SeasonThreeD</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>

    <!--
      No net10.0-browser target: trellis.cpp is a desktop worker process, and
      System.Diagnostics.Process does not exist in the wasm BCL. Android/iOS/Mac
      Catalyst compile (SeasonStudio references every AI package from all of its
      heads) but report PlatformNotSupportedException at run time - only Windows,
      Linux and macOS can host the worker.
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <IsAndroid Condition="$(TargetFramework.Contains('android'))">true</IsAndroid>
    <IsIOS Condition="$(TargetFramework.Contains('ios'))">true</IsIOS>
    <IsMacCatalyst Condition="$(TargetFramework.Contains('maccatalyst'))">true</IsMacCatalyst>
    <IsWindows Condition="$(TargetFramework.Contains('windows'))">true</IsWindows>

    <IsLinux Condition="'$(TargetFramework)' == 'net10.0'">true</IsLinux>

    <IsApple Condition="'$(IsIOS)' == 'true' or '$(IsMacCatalyst)' == 'true'">true</IsApple>
    <IsUnixLike Condition="'$(IsAndroid)' == 'true' or '$(IsLinux)' == 'true'">true</IsUnixLike>

    <SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(IsMacCatalyst)' == 'true'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(IsAndroid)' == 'true'">29.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</TargetPlatformMinVersion>

  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows x64 payload produced by .github/workflows/build-trellis.yml, one artifact
      per build but two lanes inside it:

        trellis-cli.exe         - the CUDA lane
        trellis-cli-vulkan.exe  - the Vulkan lane

      The plain name compiles trellis's own deform_conv and decimate kernels as CUDA
      (fastest on an NVIDIA card, and it refuses any non-CUDA GPU device). The -vulkan
      name is the same two kernels as SPIR-V, so one binary covers NVIDIA, AMD and Intel
      with no dependency on cudart at all. The split is not cosmetic - a CUDA build links
      cudart64_12 into its kernels and never compiles the shaders, so a single binary
      cannot serve an AMD or Intel machine without dragging the CUDA runtime onto it and
      leaving deform_conv on the CPU.

      ggml is NOT part of this payload. The worker links ggml dynamically, so the runtime
      it needs is exactly the one SeasonGGML publishes - same SeasonRealms/ggml ref, same
      GGML_BACKEND_DL / GGML_CPU_ALL_VARIANTS / GGML_MAX_NAME options - and this project
      references that package already. A second copy here is what made ggml revision skew
      possible: both copies load, then compute different meshes for the same seed. The
      worker is therefore staged in the output root, next to ggml.dll, so the loader
      resolves its imports from its own directory and ggml's backend loader scans that
      same directory for ggml-cpu-<variant>.dll / ggml-cuda.dll / ggml-vulkan.dll.

      The executables carry no manifest item beyond the glob below; the .txt files beside
      them (trellis.txt and the ggml license text) stay in runtimes\win-x64\native\ so
      they cannot collide with SeasonGGML's own README.txt at the output root
      (NETSDK1152). A worker staged the RID way - the NuGet package payload, or a
      consumer that only got the package - still resolves ggml through
      TrellisSession's PATH and GGML_BACKEND_PATH plumbing; TrellisRuntimeLocator
      searches both layouts.

      cudart64_12 / cublas64_12 / cublasLt64_12 are not here either; cudacudnn-runtime
      provides them (SeasonStudio stages that folder next to the app). Only the CUDA lane
      needs them: on a host without cudacudnn-runtime, TrellisWorker.Auto still resolves
      to the Vulkan lane, which has no CUDA import at all.

      Two invariants tie the packages together: the ggml commit SeasonRealms/ggml's
      master resolved to (0.27.0 plus the fastdiv fix and the GGML_PREC_F32
      FlashAttention patches), which every AI package builds from, and the CUDA toolkit
      version (12.8.1, what cudacudnn-runtime ships).

      The Exclude lists below are the belt to that braces: a stale local build of the
      runtimes folder cannot reintroduce a second ggml or the CUDA runtime into the
      package.
    -->
    <None Include="runtimes\win-x64\native\*" Exclude="runtimes\win-x64\native\ggml*.dll;runtimes\win-x64\native\cudart64_*.dll;runtimes\win-x64\native\cublas64_*.dll;runtimes\win-x64\native\cublasLt64_*.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes\win-x64\native')" />
    <None Include="runtimes\linux-x64\native\*" Pack="true" PackagePath="runtimes/linux-x64/native/" Condition="Exists('runtimes\linux-x64\native')" />

    <!--
      Windows heads only, and no item of their own for the lanes: -vulkan.exe is just a
      file name the workflow renames to.

      The executables go to the output ROOT, not to runtimes\win-x64\native: the worker
      imports ggml.dll and ggml's backend loader scans the executable's directory, so it
      has to sit next to SeasonGGML's runtime. That is also why the payload is empty of
      ggml (see above) - one copy, owned by SeasonGGML.

      This is a PE payload, so the other heads have nothing to do with it: without the
      condition every Android/iOS/Mac Catalyst build also copied a Windows binary set
      under runtimes\win-x64\native, and for the Apple heads that is exactly the "PE
      files inside the .app" case those projects remove elsewhere.
    -->
    <Content Include="runtimes\win-x64\native\*.exe" Condition="'$(IsWindows)' == 'true' And Exists('runtimes\win-x64\native')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
      <Pack>false</Pack>
    </Content>

    <!--
      The license/manifest text stays in the RID folder: flattening it would collide with
      SeasonGGML's own README.txt in the same output root.
    -->
    <Content Include="runtimes\win-x64\native\*.txt" Condition="'$(IsWindows)' == 'true' And Exists('runtimes\win-x64\native')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
      <Pack>false</Pack>
    </Content>

    <Content Include="runtimes\linux-x64\native\*" Exclude="runtimes\linux-x64\native\*.h;runtimes\linux-x64\native\*.txt" Condition="Exists('runtimes\linux-x64\native')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      Supplies ggml.dll, ggml-base.dll and the ggml-cpu-<variant>.dll / ggml-cuda.dll
      backend modules to the output root - and to the dependency graph of every
      consumer - when SeasonGGML has been staged. SeasonGGML is the single publisher
      of ggml everywhere: the root copy IS the worker's runtime on Windows (see
      above), and the reference is what keeps both the in-process consumers and the
      out-of-process worker on one ggml revision. Dropping it would leave the worker
      with an unresolvable import.
    -->
    <ProjectReference Include="..\SeasonGGML\SeasonGGML.csproj" />
  </ItemGroup>

</Project>
