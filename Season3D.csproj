<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Season3D</AssemblyName>
    <RootNamespace>Season.ThreeD</RootNamespace>
    <PackageId>Season3D</PackageId>
    <Title>Season3D</Title>
    <Authors>SeasonRealms</Authors>
    <Company>SeasonRealms</Company>
    <Description>Season3D wraps the trellis.cpp image-to-3D worker (TRELLIS.2 / Pixal3D, GGML) for SeasonEngine: run one image through the trellis-cli pipeline and get a textured GLB back, with stage/step progress and cancellation.</Description>
    <PackageTags>trellis;trellis.cpp;ggml;3d;image-to-3d;mesh;glb;ai;seasonengine</PackageTags>
    <PackageProjectUrl>https://github.com/SeasonRealms/Season3D</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeasonRealms/Season3D</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>

    <!--
      No net10.0-browser target: trellis.cpp is a desktop worker process, and
      System.Diagnostics.Process does not exist in the wasm BCL. Android/iOS/Mac
      Catalyst compile (SeasonStudio references every AI package from all of its
      heads) but report PlatformNotSupportedException at run time - only Windows,
      Linux and macOS can host the worker.
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <IsAndroid Condition="$(TargetFramework.Contains('android'))">true</IsAndroid>
    <IsIOS Condition="$(TargetFramework.Contains('ios'))">true</IsIOS>
    <IsMacCatalyst Condition="$(TargetFramework.Contains('maccatalyst'))">true</IsMacCatalyst>
    <IsWindows Condition="$(TargetFramework.Contains('windows'))">true</IsWindows>

    <IsLinux Condition="'$(TargetFramework)' == 'net10.0'">true</IsLinux>

    <IsApple Condition="'$(IsIOS)' == 'true' or '$(IsMacCatalyst)' == 'true'">true</IsApple>
    <IsUnixLike Condition="'$(IsAndroid)' == 'true' or '$(IsLinux)' == 'true'">true</IsUnixLike>

    <SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(IsMacCatalyst)' == 'true'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(IsAndroid)' == 'true'">29.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</TargetPlatformMinVersion>

  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows x64 payload produced by .github/workflows/build-trellis.yml:
      trellis-cli.exe (the worker this package shells out to), trellis-server.exe,
      trellis.dll (the thin C ABI lane - exports trellis_run_argv, which runs the
      same parse_args()+trellis_run() pair the cli runs; the entry point is
      native/trellis_capi.cpp, attached to the trellis.cpp build by
      native/apply-capi-lane.ps1, which the workflow and a local build both run),
      the shared ggml runtime they import (ggml.dll, ggml-base.dll and - depending
      on the backend - ggml-cpu.dll / ggml-cuda.dll) and, for the CUDA lane,
      cudart64_12.dll / cublas64_12.dll / cublasLt64_12.dll. A worker process
      resolves every one of them from its own directory and a loaded trellis.dll
      resolves them from the host executable's directory, so they travel together
      and must stay in one flat folder.

      ggml is built as shared libraries (BUILD_SHARED_LIBS=ON) with
      GGML_BACKEND_DL=OFF and GGML_MAX_NAME=128 - the same tensor-layout override
      SeasonGGML, SeasonImage and SeasonTTS compile with, which is what makes the
      DLL set interchangeable once the pinned ggml revision is aligned as well.
      Until then this package carries its own copy: two different ggml.dll builds
      cannot coexist in one directory (the loader keeps the first one it finds),
      so shipping several AI packages side by side requires them to agree on a
      single ggml build.
    -->
    <None Include="runtimes\win-x64\native\*" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes\win-x64\native')" />
    <None Include="runtimes\linux-x64\native\*" Pack="true" PackagePath="runtimes/linux-x64/native/" Condition="Exists('runtimes\linux-x64\native')" />

    <Content Include="runtimes\win-x64\native\*.exe;runtimes\win-x64\native\*.dll" Condition="Exists('runtimes\win-x64\native')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
      <Pack>false</Pack>
    </Content>

    <Content Include="runtimes\linux-x64\native\*" Exclude="runtimes\linux-x64\native\*.h;runtimes\linux-x64\native\*.txt" Condition="Exists('runtimes\linux-x64\native')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

</Project>
